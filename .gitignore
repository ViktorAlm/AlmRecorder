# Swift Package Manager
# NOTE: Package.resolved IS committed (this is an app — pin deps for reproducible builds).
# NOTE: prebuilt native libs under AlmRecorder/Resources/{Libraries,Binaries} ARE committed
#       on purpose (Approach 1). Do not add *.dylib here.

# ---- Models (downloaded at runtime, never committed) ----
*.bin
*.gguf
*.safetensors
*.pt
*.pth
*.onnx

# ---- Audio / recordings (never commit user media) ----
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.aiff
*.caf
